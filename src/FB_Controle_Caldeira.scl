// ==============================================================================
// FUNCTION BLOCK: FB_Controle_Caldeira
// Plataforma: Siemens SIMATIC S7-1200 / S7-1500
// ==============================================================================

FUNCTION_BLOCK "FB_Controle_Caldeira"
TITLE = 'Bloco de Controle e Seguranca da Caldeira'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      // Sinais Digitais de Campo (Slide 5)
      Botao_Liga : Bool;        // I0.0 (NA) - Pulso de partida
      Botao_Desliga : Bool;     // I0.1 (NF) - Botao parada natural (1=Repouso, 0=Pressionado)
      Botao_Reset : Bool;       // I0.2 (NF) - Pulso de reconhecimento de falha (1=Repouso, 0=Pressionado)
      Botao_Emergencia : Bool;  // I0.3 (NF Retencao) - Parada imediata (1=Seguro/Destravado, 0=Emergencia)
      
      // Sinais Analogicos Brutos (4-20mA / 0 a 27648)
      AI_Nivel_Raw : Int;       // IW64 (AI0) - Nivel do reservatorio
      AI_Pressao_Raw : Int;     // IW66 (AI1) - Pressao interna do cilindro
      AI_Temp_Raw : Int;        // IW68 (AI2) - Temperatura do trocador
      
      // Parametros Ajustaveis de Processo
      Nivel_Liga_Agua : Real := 50.0;       // % Nivel minimo para ligar valvula de abastecimento
      Nivel_Desliga_Agua : Real := 75.0;    // % Nivel superior para fechar valvula de agua
      Temp_Min_Vapor : Real := 80.0;        // % Temperatura minima para liberar valvula de vapor
      Pressao_Min_Vapor : Real := 70.0;     // % Pressao interna minima para liberar valvula de vapor
      Pressao_Max_Seguranca : Real := 95.0; // % Pressao de sobrepressao critica
   END_VAR

   VAR_OUTPUT 
      // Saidas Digitais para Atuadores e Valvulas
      Valvula_Agua : Bool;      // Q0.0 - Valvula on/off abastecimento de agua
      Valvula_Vapor : Bool;     // Q0.1 - Valvula principal da linha de vapor
      Valvula_Alivio : Bool;    // Q0.2 - Valvula de alivio de emergencia
      
      // Saidas Digitais dos 6 Queimadores (Etapa 2)
      Queimador_1 : Bool;       // Q0.3
      Queimador_2 : Bool;       // Q0.4
      Queimador_3 : Bool;       // Q0.5
      Queimador_4 : Bool;       // Q0.6
      Queimador_5 : Bool;       // Q0.7
      Queimador_6 : Bool;       // Q1.0
      
      // Sinalizacao e Painel
      Lamp_Em_Operacao : Bool;  // Q1.1 - Luz piloto sistema ligado
      Lamp_Emergencia : Bool;   // Q1.2 - Luz piloto alarme de emergencia
      
      // Variaveis de Processo Escalonadas (0 a 100%)
      Nivel_Perc : Real;
      Pressao_Perc : Real;
      Temp_Perc : Real;
      Sistema_Ligado : Bool;
      Emergencia_Ativa : Bool;
      Qtd_Queimadores_Ativos : Int;
   END_VAR

   VAR 
      // Variaveis Internas e Flags de Borda
      stat_Sistema_Ligado : Bool := FALSE;
      stat_Emergencia_Latched : Bool := FALSE;
      stat_Valvula_Agua : Bool := FALSE;
      
      stat_Liga_Prev : Bool := FALSE;
      stat_Reset_Prev : Bool := FALSE;
      stat_Desliga_Prev : Bool := TRUE;
   END_VAR

   VAR_TEMP 
      pulso_Liga : Bool;
      pulso_Reset : Bool;
      pulso_Desliga : Bool;
      rNivel_Calc : Real;
      rPressao_Calc : Real;
      rTemp_Calc : Real;
      condicao_Queimadores_OK : Bool;
   END_VAR

BEGIN
   // 1. ESCALONAMENTO S7 (0..27648 -> 0..100%)
   rNivel_Calc := (INT_TO_REAL(#AI_Nivel_Raw) / 27648.0) * 100.0;
   IF rNivel_Calc < 0.0 THEN rNivel_Calc := 0.0; ELSIF rNivel_Calc > 100.0 THEN rNivel_Calc := 100.0; END_IF;
   #Nivel_Perc := rNivel_Calc;

   rPressao_Calc := (INT_TO_REAL(#AI_Pressao_Raw) / 27648.0) * 100.0;
   IF rPressao_Calc < 0.0 THEN rPressao_Calc := 0.0; ELSIF rPressao_Calc > 100.0 THEN rPressao_Calc := 100.0; END_IF;
   #Pressao_Perc := rPressao_Calc;

   rTemp_Calc := (INT_TO_REAL(#AI_Temp_Raw) / 27648.0) * 100.0;
   IF rTemp_Calc < 0.0 THEN rTemp_Calc := 0.0; ELSIF rTemp_Calc > 100.0 THEN rTemp_Calc := 100.0; END_IF;
   #Temp_Perc := rTemp_Calc;

   // 2. DETECCAO DE BORDAS
   pulso_Liga := #Botao_Liga AND NOT #stat_Liga_Prev;
   #stat_Liga_Prev := #Botao_Liga;

   pulso_Reset := (NOT #Botao_Reset) AND #stat_Reset_Prev;
   #stat_Reset_Prev := #Botao_Reset;

   pulso_Desliga := (NOT #Botao_Desliga) AND #stat_Desliga_Prev;
   #stat_Desliga_Prev := #Botao_Desliga;

   // 3. ETAPAS 4 E 5: CIRCUITO DE SEGURANCA E EMERGENCIA
   IF NOT #Botao_Emergencia THEN
      #stat_Emergencia_Latched := TRUE;
      #stat_Sistema_Ligado := FALSE;
   ELSIF #stat_Emergencia_Latched AND #Botao_Emergencia AND pulso_Reset THEN
      #stat_Emergencia_Latched := FALSE;
   END_IF;

   // 4. PARTIDA E PARADA NORMAL
   IF #stat_Emergencia_Latched THEN
      #stat_Sistema_Ligado := FALSE;
   ELSIF pulso_Desliga OR (NOT #Botao_Desliga) THEN
      #stat_Sistema_Ligado := FALSE;
   ELSIF pulso_Liga AND (NOT #stat_Emergencia_Latched) AND #Botao_Desliga THEN
      #stat_Sistema_Ligado := TRUE;
   END_IF;

   // 5. ETAPA 1: CONTROLE DE ABASTECIMENTO DE AGUA
   IF rNivel_Calc < #Nivel_Liga_Agua THEN
      #stat_Valvula_Agua := TRUE;
   ELSIF rNivel_Calc >= #Nivel_Desliga_Agua THEN
      #stat_Valvula_Agua := FALSE;
   END_IF;
   #Valvula_Agua := #stat_Valvula_Agua;

   // 6. ETAPA 2: OTIMIZACAO TERMICA DOS QUEIMADORES
   condicao_Queimadores_OK := #stat_Sistema_Ligado 
                              AND (NOT #stat_Emergencia_Latched) 
                              AND (rNivel_Calc >= #Nivel_Liga_Agua);

   IF NOT condicao_Queimadores_OK THEN
      #Queimador_1 := FALSE;
      #Queimador_2 := FALSE;
      #Queimador_3 := FALSE;
      #Queimador_4 := FALSE;
      #Queimador_5 := FALSE;
      #Queimador_6 := FALSE;
      #Qtd_Queimadores_Ativos := 0;
   ELSE
      IF rTemp_Calc >= 80.0 THEN
         #Queimador_1 := TRUE;
         #Queimador_2 := TRUE;
         #Queimador_3 := FALSE;
         #Queimador_4 := FALSE;
         #Queimador_5 := FALSE;
         #Queimador_6 := FALSE;
         #Qtd_Queimadores_Ativos := 2;
      ELSIF rTemp_Calc >= 60.0 THEN
         #Queimador_1 := TRUE;
         #Queimador_2 := TRUE;
         #Queimador_3 := TRUE;
         #Queimador_4 := FALSE;
         #Queimador_5 := FALSE;
         #Queimador_6 := FALSE;
         #Qtd_Queimadores_Ativos := 3;
      ELSIF rTemp_Calc >= 40.0 THEN
         #Queimador_1 := TRUE;
         #Queimador_2 := TRUE;
         #Queimador_3 := TRUE;
         #Queimador_4 := TRUE;
         #Queimador_5 := FALSE;
         #Queimador_6 := FALSE;
         #Qtd_Queimadores_Ativos := 4;
      ELSIF rTemp_Calc >= 20.0 THEN
         #Queimador_1 := TRUE;
         #Queimador_2 := TRUE;
         #Queimador_3 := TRUE;
         #Queimador_4 := TRUE;
         #Queimador_5 := TRUE;
         #Queimador_6 := FALSE;
         #Qtd_Queimadores_Ativos := 5;
      ELSE
         #Queimador_1 := TRUE;
         #Queimador_2 := TRUE;
         #Queimador_3 := TRUE;
         #Queimador_4 := TRUE;
         #Queimador_5 := TRUE;
         #Queimador_6 := TRUE;
         #Qtd_Queimadores_Ativos := 6;
      END_IF;
   END_IF;

   // 7. ETAPA 3: LINHA DE VAPOR (LIBERACAO E INTERTRAVAMENTO)
   IF #stat_Sistema_Ligado 
      AND (NOT #stat_Emergencia_Latched) 
      AND (rTemp_Calc > #Temp_Min_Vapor) 
      AND (rPressao_Calc > #Pressao_Min_Vapor) THEN
      #Valvula_Vapor := TRUE;
   ELSE
      #Valvula_Vapor := FALSE;
   END_IF;

   // 8. VALVULA DE ALIVIO DE EMERGENCIA
   IF #stat_Emergencia_Latched OR (rPressao_Calc >= #Pressao_Max_Seguranca) THEN
      #Valvula_Alivio := TRUE;
   ELSE
      #Valvula_Alivio := FALSE;
   END_IF;

   // 9. SINALIZACOES
   #Sistema_Ligado := #stat_Sistema_Ligado;
   #Emergencia_Ativa := #stat_Emergencia_Latched;
   #Lamp_Em_Operacao := #stat_Sistema_Ligado AND (NOT #stat_Emergencia_Latched);
   #Lamp_Emergencia := #stat_Emergencia_Latched;

END_FUNCTION_BLOCK
